    define('GENESYS_ACCOUNT_HASH', 'COLOQUE_SEU_ACCOUNT_HASH_AQUI');
}

if (!defined('GENESYS_API_TOKEN')) {
    define('GENESYS_API_TOKEN', 'COLOQUE_SEU_API_TOKEN_AQUI');
}
