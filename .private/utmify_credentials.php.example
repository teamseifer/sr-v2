// CREDENCIAIS UTMify (renomeie este arquivo para utmify_credentials.php)
// =============================================================================
// Como obter o token:
// 1. Acesse seu dashboard UTMify
// 2. Va em: Integracoes > Webhooks > Credenciais de API
// 3. Clique em "Adicionar Credencial"
// 4. De um nome (ex: "Funil Desenrola")
// 5. Copie o token gerado
// 6. Cole no lugar de COLOQUE_SEU_TOKEN_AQUI abaixo
// =============================================================================
defined('UTMIFY_API_TOKEN') || define('UTMIFY_API_TOKEN', 'COLOQUE_SEU_TOKEN_AQUI');
defined('UTMIFY_API_URL')   || define('UTMIFY_API_URL', 'https://api.utmify.com.br/api-credentials/orders');
