# =============================================================================
# .env.example  ->  copie para .private/.env  e preencha os valores reais
# =============================================================================
# Este arquivo (.env.example) e um MODELO e pode ir para o repositorio.
# O arquivo REAL (.private/.env) NUNCA deve ser commitado (ja esta no .gitignore)
# e fica bloqueado para acesso HTTP pelo .htaccess de .private/.
#
# Como aplicar:
#   1. cp .private/.env.example .private/.env
#   2. Edite .private/.env e cole as credenciais reais.
#   3. Pronto: o api_proxy.php le tudo daqui via variaveis de ambiente.
# =============================================================================

# ----- Disrupty (gateway PIX) --------------------------------------------------
# Painel Disrupty > Integracoes/API > Credenciais (modo SELLER, chaves "dsrp_")
DISRUPTY_PUBLIC_KEY=COLOQUE_SUA_PUBLIC_KEY_AQUI
DISRUPTY_PRIVATE_KEY=COLOQUE_SUA_PRIVATE_KEY_AQUI
# (opcional) Base da API — padrao ja embutido:
# DISRUPTY_BASE_URL=https://api-sellers.disruptybr.app

# ----- Utmify (rastreamento de pedidos) --------------------------------------
# Dashboard Utmify > Integracoes > Webhooks > Credenciais de API
UTMIFY_API_TOKEN=
UTMIFY_API_URL=https://api.utmify.com.br/api-credentials/orders

# ----- Seguranca do Webhook (RECOMENDADO) ------------------------------------
# A Disrupty NAO envia header de autenticacao no webhook: o segredo vai NA URL
# (?token=SEU_SEGREDO). Gere um valor aleatorio (ex.: openssl rand -hex 32) e
# preencha abaixo ANTES de rodar ?action=setup_webhook (registra a URL com o token).
# Se ficar vazio, a verificacao de autenticidade do webhook fica DESATIVADA.
WEBHOOK_SECRET=

# ----- Diagnostico (nenhuma variavel necessaria) -----------------------------
# Para diagnosticar um "Erro interno no proxy", abra no navegador:
#   https://SEU-DOMINIO/api_proxy.php?action=diag
# Retorna um JSON com credentials_source (deve ser "env"), pronto_para_pix,
# seguranca_servidor.funcoes_bloqueadas_relevantes (mostra se o aaPanel desativou
# putenv/getenv), seguranca_servidor.open_basedir, curl_enabled e bootstrap_errors.
# Nao expoe as credenciais.

# ----- Recuperacao de PIX por e-mail (motor de e-mails automaticos) ----------
# Servidor SMTP usado para enviar os e-mails de recuperacao.
# RECOMENDADO: Brevo (brevo.com) - gratis ate 300 e-mails/dia, sem cartao.
#   Pegue o SMTP em: nome (canto sup. direito) > SMTP & API > aba SMTP.
# Tambem funciona SendGrid (host smtp.sendgrid.net, USER=apikey, PASS=SG...),
#   um e-mail da sua hospedagem, Zoho/Titan, ou Gmail com senha de app.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# "tls" (STARTTLS) para porta 587  |  "ssl" para porta 465
SMTP_SECURE=tls
SMTP_USER=85xxxx@smtp-brevo.com
SMTP_PASS=SUA_SMTP_KEY_AQUI
# Remetente exibido para o cliente (se vazio, usa SMTP_USER)
SMTP_FROM_EMAIL=contato@seudominio.com
SMTP_FROM_NAME=Serasa Limpa Nome

# URL publica do site (usada para montar o link "retomar pagamento" dos e-mails)
RECOVERY_BASE_URL=https://seudominio.com

# Segredo dos links de recuperacao e do cron via navegador.
# Gere com: openssl rand -hex 32  (se vazio, usa GENESYS_WEBHOOK_SECRET)
RECOVERY_SECRET=

# Valor com desconto oferecido no 3o e-mail (ultima chance). Padrao: 19.90
RECOVERY_DISCOUNT_PRICE=34.90

# ----- API de CPF (login / consultar_cpf) — preferir secrets-cpf/.env --------
# Primaria: apicpf — GET ?cpf= + header X-API-KEY
# CPF_API_URL=https://api.apicpf.dev/consulta
# CPF_API_TOKEN=
# CPF_API_KEY=
# CPF_API_MODE=xapikey
# Fallback 1: apicpf (outra chave)
# CPF_API2_URL=https://api.apicpf.dev/consulta
# CPF_API2_TOKEN=
# CPF_API2_KEY=
# CPF_API2_MODE=xapikey
# Fallback 2: ZapGroup — GET ?token=&cpf=
# CPF_API3_URL=https://api.zapgroup.shop/consultar-filtrada/cpf
# CPF_API3_TOKEN=
# CPF_API3_KEY=
# CPF_API3_MODE=query
# CPF_CACHE_TTL=86400

# ============================================================
# NOTIFICACOES PUSH — Pushcut ou Webhooky
# ============================================================
# URL do seu endpoint de push (a URL e o proprio segredo — nao compartilhe)
#   Pushcut : https://api.pushcut.io/SEU_SEGREDO/notifications/NOME_DA_NOTIFICACAO
#   Webhooky: https://api.webhooky.app/SEU_ID
NOTIFY_WEBHOOK_URL=https://api.pushcut.io/COLOQUE_SEU_SEGREDO/notifications/COLOQUE_O_NOME

# Provider (opcional): 'pushcut' ou 'webhooky'. Se vazio, detectado pela URL.
# NOTIFY_PROVIDER=pushcut

# Alerta inteligente: quantos PIX gerados seguidos sem nenhuma conversao antes de avisar (padrao 10)
# NOTIFY_ALERT_STREAK=10
