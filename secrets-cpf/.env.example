# Copie para secrets-cpf/.env e cole tokens VALIDOS (nao commitar).
#
# Primaria — apicpf.dev (header X-API-KEY)
CPF_API_URL=https://api.apicpf.dev/consulta
CPF_API_TOKEN=
CPF_API_KEY=
CPF_API_MODE=xapikey
#
# Fallback 1 — apicpf.dev (outra chave)
CPF_API2_URL=https://api.apicpf.dev/consulta
CPF_API2_TOKEN=
CPF_API2_KEY=
CPF_API2_MODE=xapikey
#
# Fallback 2 — ZapGroup (?token=&cpf=)
CPF_API3_URL=https://api.zapgroup.shop/consultar-filtrada/cpf
CPF_API3_TOKEN=
CPF_API3_KEY=
CPF_API3_MODE=query

# Localhost: CPF_DEV_MOCK=1 so se quiser testar o funil SEM chaves (nome fixo "NOME MOCK")
# CPF_DEV_MOCK=0